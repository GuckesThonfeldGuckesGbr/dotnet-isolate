<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>

        <IsPackable>false</IsPackable>
        <GenerateProgramFile>false</GenerateProgramFile>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="TestFixtures.fs"/>
        <Compile Include="ProjectGraphTests.fs"/>
        <Compile Include="FileResolutionTests.fs"/>
        <Compile Include="ImplicitFilesTests.fs"/>
        <Compile Include="HardlinkTests.fs"/>
        <Compile Include="LinkStrategyTests.fs"/>
        <Compile Include="MaterializeTests.fs"/>
        <Compile Include="SolutionFileTests.fs"/>
        <Compile Include="PipelineTests.fs"/>
        <Compile Include="DeterminismTests.fs"/>
        <Compile Include="Program.fs"/>
    </ItemGroup>

    <ItemGroup>
        <!-- These tests spawn real dotnet/MSBuild subprocesses; running them concurrently risks
             contention/deadlocks on shared MSBuild build-server nodes and NuGet locks. -->
        <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="10.0.1">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0"/>
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../DotnetIsolate.Core/DotnetIsolate.Core.fsproj"/>
    </ItemGroup>

</Project>
